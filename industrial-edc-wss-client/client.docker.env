# =============================================================
# OPC-UA WSS Client – DOCKER COMPOSE configuration
# =============================================================
# Used automatically by docker-compose.yml via env_file directive.
# Service hostnames refer to Docker network service names, not
# localhost.
#
# Adjust values to match your docker-compose service names.
# =============================================================

# -------------------------------------------------------------
# WebSocket connection
# "connector" is the service name of the EDC provider connector
# in your docker-compose network.
# -------------------------------------------------------------
WSS_ENDPOINT=ws://host.docker.internal:8181/industrial-ws
WSS_API_KEY=changeme
WSS_CLIENT_ID=industrial-connector-wss-client-docker-01
WSS_RECONNECT_INTERVAL_MS=5000

# -------------------------------------------------------------
# MQTT broker  (provider-managed Mosquitto)
# "mosquitto" is the service name of the MQTT broker.
# -------------------------------------------------------------

# --- TLS / certificate-based ---
#MQTT_BROKER_URL=ssl://mosquitto:8883
#MQTT_CA_CERT_PATH=/app/certs/ca-chain.cert.pem
#MQTT_CLIENT_CERT_PATH=/app/certs/push-user.crt
#MQTT_CLIENT_KEY_PATH=/app/certs/push-user.key.pem

# --- OR: username/password (uncomment and comment out TLS block above) ---
MQTT_BROKER_URL=tcp://mosquitto:1883
MQTT_USERNAME=push-user
MQTT_PASSWORD=pass123

# -------------------------------------------------------------
# OPC-UA server
# "opcua-server" is the service name of the OPC-UA simulator
# or real PLC gateway in your docker-compose network.
# -------------------------------------------------------------
# Override the OPC-UA server URL sent by the EDC connector so
# the client connects via the Docker network service name.
OPCUA_SERVER_URL=opc.tcp://opcua-server:4840

# Anonymous access (default – leave credentials blank)
# OPCUA_USERNAME=
# OPCUA_PASSWORD=

# Username / password OPC-UA
#OPCUA_USERNAME=opcua-user
#OPCUA_PASSWORD=opcua-password

# Certificate-based OPC-UA
#OPCUA_CLIENT_CERT_PATH=/app/certs/opcua-client.crt
#OPCUA_CLIENT_KEY_PATH=/app/certs/opcua-client.key.pem

